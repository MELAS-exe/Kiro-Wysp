# Copy to .env (git-ignored). Everything is optional: without any key Wysp uses keyless Pollinations,
# which works but is slow and unreliable (roughly every second request stalls).
#
# Recommended for development: a free Groq key (no credit card, ~30 requests/min, fast, supports tool calls).
#   1. https://console.groq.com/keys  ->  Create API Key
#   2. paste it below
GROQ_API_KEY=

# Alternatives (free tiers, no credit card): Cerebras, OpenRouter
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Force a provider / model (default: first provider with a key, else pollinations):
# WYSP_LLM_PROVIDER=groq
# WYSP_LLM_MODEL=llama-3.3-70b-versatile
# Any OpenAI-compatible endpoint:
# WYSP_LLM_PROVIDER=custom
# WYSP_LLM_BASE_URL=https://example.com/v1
# WYSP_LLM_API_KEY=

# Extra allowed WebSocket origins, comma separated (for example the Chrome extension later):
# WYSP_ALLOWED_ORIGINS=
