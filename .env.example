# Copy to .env (git-ignored). Everything is optional: without any key Wysp uses keyless Pollinations,
# which works but is slow and unreliable (roughly every second request stalls).
#
# Recommended for development: a free Groq key (no credit card, ~30 requests/min, fast, supports tool calls).
#   1. https://console.groq.com/keys  ->  Create API Key
#   2. paste it below
GROQ_API_KEY=

# Alternatives (free tiers, no credit card): Cerebras, OpenRouter
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Force a provider / model (default: first provider with a key, else pollinations):
# WYSP_LLM_PROVIDER=groq
# WYSP_LLM_MODEL=openai/gpt-oss-120b
# Any OpenAI-compatible endpoint:
# WYSP_LLM_PROVIDER=custom
# WYSP_LLM_BASE_URL=https://example.com/v1
# WYSP_LLM_API_KEY=

# Extra allowed WebSocket origins, comma separated (for example the Chrome extension later):
# WYSP_ALLOWED_ORIGINS=

# Session telemetry in ~/.wysp/logs/ (one JSONL file per Core session and per Blender session):
#   off    nothing
#   basic  timings, counts, errors; no conversation content
#   full   (default) also user messages, narration, prompts, model replies, tool arguments and results
# Secrets are redacted, but full logs contain what you said to the tutor. Change it live from either Panel.
# WYSP_LOG=full

# Voice for Panels that cannot speak by themselves (the one inside Blender), served by POST /api/tts.
# auto (default): the voices installed in Windows, offline, no key, nothing leaves your machine. none: off.
# WYSP_TTS_PROVIDER=auto
# Pick a voice by part of its name (default: the first one matching the session language), e.g. Zira or David.
# WYSP_TTS_VOICE=Zira

# Text recognition for hybrid adapters (POST /api/ocr): auto (default) = Windows' built-in OCR, offline. none: off.
# WYSP_OCR_PROVIDER=auto
