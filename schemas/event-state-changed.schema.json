{
  "$id": "https://wysp.dev/schemas/1/event-state-changed.schema.json",
  "additionalProperties": false,
  "properties": {
    "changed": {
      "items": {
        "maxLength": 512,
        "pattern": "^[a-z][a-z0-9+.-]*://.+$",
        "type": "string"
      },
      "title": "Changed",
      "type": "array"
    },
    "origin": {
      "default": "unknown",
      "enum": [
        "user",
        "wysp",
        "unknown"
      ],
      "title": "Origin",
      "type": "string"
    },
    "state_version": {
      "minimum": 0,
      "title": "State Version",
      "type": "integer"
    }
  },
  "required": [
    "state_version"
  ],
  "title": "StateChanged",
  "type": "object"
}
