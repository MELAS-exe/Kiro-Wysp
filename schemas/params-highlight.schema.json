{
  "$id": "https://wysp.dev/schemas/1/params-highlight.schema.json",
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "default": 2500,
      "maximum": 10000,
      "minimum": 100,
      "title": "Duration Ms",
      "type": "integer"
    },
    "ref": {
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9+.-]*://.+$",
      "title": "Ref",
      "type": "string"
    },
    "style": {
      "default": "pulse",
      "enum": [
        "pulse",
        "outline"
      ],
      "title": "Style",
      "type": "string"
    }
  },
  "required": [
    "ref"
  ],
  "title": "HighlightParams",
  "type": "object"
}
