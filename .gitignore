# Keep .kiro/ committed: it is part of the Kiroween submission.

# Secrets and local configuration
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
.mypy_cache/
*.egg-info/
build/

# Node and front-end builds
node_modules/
dist/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Blender
*.blend1
*.blend2
apps/blender-tutor/demo/*.blend

# Contract kit outputs (recordings in apps/*/contract-recordings/ ARE committed)
contract-tests/reports/
*.junit.xml

# LaTeX build by-products (the PDF itself is committed)
docs/architecture/*.log
docs/architecture/*.aux
docs/architecture/*.xdv
docs/architecture/*.png

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
