{
  "name": "@wysp/adapter-sdk",
  "version": "0.1.0",
  "description": "Wysp TypeScript adapter SDK: contract types generated from schemas/ and a WebSocket JSON-RPC client for MV3 service workers",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "json-schema-to-typescript": "*",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
